rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /memories/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == 'owner'
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == 'owner';
    }

    // Public read on purpose: the Letters page still has a passcode curtain,
    // but multi-MB PDFs must stream without an authenticated getBlob round-trip.
    match /letters/{fileName} {
      allow read:   if true;
      allow create: if request.auth != null && request.auth.uid == 'owner'
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow update, delete: if request.auth != null && request.auth.uid == 'owner';
    }

    // Closet photos: one compressed JPEG per wardrobe item, mirrored from
    // IndexedDB by cloudSync.wardrobePhotoCloud. Read needs the site passcode
    // too — these are hers, not gallery images.
    match /wardrobe/{fileName} {
      allow read:   if request.auth != null && request.auth.uid == 'owner';
      allow create, update: if request.auth != null && request.auth.uid == 'owner'
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == 'owner';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
